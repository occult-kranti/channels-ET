{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/occult-kranti/channels-ET/research/collection-policy/schema.json",
  "title": "One metadata-only collection policy selection record",
  "type": "object",
  "required": ["schema_version", "source_id", "video_id", "source_url", "classification", "classification_evidence", "actual_speaker_status", "source_refs", "publisher_account_ids", "channel_route_ids", "duration_state", "duration_seconds", "duration_values_seconds", "duration_observations", "shorts_evidence", "live_platform_format_verified", "historical_upload_date_observations", "original_session_date", "original_session_identity", "repost_status", "eligible_on_inherited_metadata", "metadata_refresh_required", "hold_or_exclusion_reasons", "sampling_group_kind", "sampling_group_id", "bashar_eligible_rank", "selected_default", "selected_conservative_all_materials", "default_decision", "conservative_decision", "acquisition_status"],
  "properties": {
    "schema_version": {"const": 1},
    "source_id": {"type": "string", "pattern": "^youtube:[A-Za-z0-9_-]{11}$"},
    "video_id": {"type": "string", "pattern": "^[A-Za-z0-9_-]{11}$"},
    "source_url": {"type": "string", "pattern": "^https://www\\.youtube\\.com/watch\\?v=[A-Za-z0-9_-]{11}$"},
    "title": {"type": ["string", "null"]},
    "classification": {"enum": ["explicit_bashar_association", "ambiguous_bashar_context", "not_bashar_labeled_in_available_metadata"]},
    "classification_evidence": {"type": "array", "items": {"type": "object", "required": ["kind", "source_refs"], "properties": {"kind": {"type": "string"}, "source_refs": {"type": "array", "items": {"$ref": "#/$defs/sourceRef"}}}}},
    "actual_speaker_status": {"const": "unknown_not_audio_verified"},
    "source_refs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/sourceRef"}},
    "publisher_account_ids": {"$ref": "#/$defs/strings"},
    "publisher_labels": {"$ref": "#/$defs/strings"},
    "channel_route_ids": {"$ref": "#/$defs/strings"},
    "duration_state": {"enum": ["eligible_duration", "under_minimum", "unknown", "conflicting", "invalid"]},
    "duration_seconds": {"type": ["number", "null"], "exclusiveMinimum": 0},
    "duration_values_seconds": {"type": "array", "uniqueItems": true, "items": {"type": "number", "exclusiveMinimum": 0}},
    "duration_observations": {"type": "array", "items": {"type": "object", "required": ["field", "seconds", "source_ref"]}},
    "shorts_evidence": {"type": "array", "items": {"type": "object", "required": ["kind", "live_platform_verified"], "properties": {"kind": {"enum": ["inherited_shorts_url", "inherited_explicit_short_format_flag", "title_marker_heuristic"]}, "live_platform_verified": {"const": false}}}},
    "live_platform_format_verified": {"const": false},
    "historical_upload_date_observations": {"type": "array", "items": {"type": "object", "required": ["date", "published_timestamp", "date_source", "interpretation", "source_id", "locator", "sha256"]}},
    "original_session_date": {"type": "null"},
    "original_session_identity": {"type": "null"},
    "repost_status": {"const": "unresolved_distinct_uploads_may_repeat_original_sessions"},
    "eligible_on_inherited_metadata": {"type": "boolean"},
    "metadata_refresh_required": {"const": true},
    "hold_or_exclusion_reasons": {"$ref": "#/$defs/strings"},
    "sampling_group_kind": {"enum": ["inherited_publisher_group", "inherited_route_alias_component", "unresolved_upload_id"]},
    "sampling_group_id": {"type": "string"},
    "bashar_eligible_rank": {"type": ["integer", "null"], "minimum": 1},
    "selected_default": {"type": "boolean"},
    "selected_conservative_all_materials": {"type": "boolean"},
    "default_decision": {"enum": ["selected_pending_access_and_metadata_refresh", "held_bashar_global_cap", "held_or_excluded"]},
    "conservative_decision": {"enum": ["selected_pending_access_and_metadata_refresh", "held_bashar_global_cap", "held_or_excluded"]},
    "acquisition_status": {"const": "not_downloaded_by_this_layer"}
  },
  "$defs": {
    "strings": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "sourceRef": {"type": "object", "required": ["source_id", "locator"], "properties": {"source_id": {"type": "string"}, "locator": {"type": "string"}}}
  }
}
