    {
      "id": "TK-L06",
      "title": "MiniSearch 7.2.0",
      "kind": "open_source_browser_library",
      "publication_date": null,
      "version": "npm 7.2.0",
      "publication_status": "MIT-licensed software; not a research-paper benchmark",
      "implementation_status": "vendored_and_api_tested",
      "limitations": [
