      "regex": "\\b(?:histor\\w*|ancient|atlant\\w*|government\\w*|politic\\w*|religion\\w*|society|humanity|civilization\\w*)\\b"
    }
  ],
  "modality": [
    {
      "id": "conditional",
      "regex": "\\b(?:if|unless|depend\\w*|provided|as long as)\\b"
    },
    {
      "id": "possibility",
      "regex": "\\b(?:may|might|could|possibly|perhaps|potential\\w*)\\b"
    },
    {
      "id": "probability",
      "regex": "\\b(?:likely|unlikely|probab\\w*|chance\\w*)\\b|\\b\\d+\\s*%"
    },
    {
      "id": "absolute",
      "regex": "\\b(?:always|never|everyone|everything|nothing|all|must|guarantee\\w*)\\b"
    },
    {
      "id": "imperative",
      "regex": "^(?:follow|act|choose|trust|use|find|remember|let|focus|be|don't|do not)\\b"
    }
