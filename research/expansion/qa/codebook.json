    },
    {
      "id": "physical",
      "label": "Body, health and physical claims",
      "regex": "\\b(?:health\\w*|heal\\w*|disease\\w*|diet\\w*|brain\\w*|physics|quantum|frequency|frequencies|vibrat\\w*|energy|energies)\\b"
    },
    {
      "id": "prediction",
